# ══════════════════════════════════════════════════════════
# Current - Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# See INTEGRATIONS_MASTER_GUIDE.md for detailed setup instructions
# ══════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────
# CORE APPLICATION (Required)
# ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# ──────────────────────────────────────────────────────────
# DATABASE (Required)
# ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database

# For local PostgreSQL:
DATABASE_URL=postgresql://current:current_password@localhost:5432/current_db

# For Docker PostgreSQL (setup.sh will update this if using Docker):
# DATABASE_URL=postgresql://current:current_password@localhost:5556/current_db

# ──────────────────────────────────────────────────────────
# AUTHENTICATION & SESSION (Required)
# ──────────────────────────────────────────────────────────
# Generate a secure random string: openssl rand -hex 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ──────────────────────────────────────────────────────────
# REPLIT OAUTH (Only for Replit Deployment)
# ──────────────────────────────────────────────────────────
# These are automatically provided by Replit
# No manual configuration needed for local development

# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DOMAINS=
# REPLIT_CONNECTORS_HOSTNAME=
# REPL_IDENTITY=
# WEB_REPL_RENEWAL=
# REPLIT_DEPLOYMENT=

# ══════════════════════════════════════════════════════════
# REQUIRED INTEGRATIONS
# ══════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────
# AI SERVICE - Anthropic Claude (Required for Knowledge Extraction)
# ──────────────────────────────────────────────────────────
# Get your API key at: https://console.anthropic.com
# Plans: Free tier available, then pay-as-you-go
# Used for: Extracting knowledge from all content sources

AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ──────────────────────────────────────────────────────────
# EMAIL SERVICE - Resend (Required for Team Invitations)
# ──────────────────────────────────────────────────────────
# Get your API key at: https://resend.com
# Free tier: 100 emails/day, 3,000 emails/month
# Used for: Team member invitations, notifications

RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEMO_NOTIFY_EMAIL=

# ──────────────────────────────────────────────────────────
# NOTION INTEGRATION (Required - Output Destination)
# ──────────────────────────────────────────────────────────
# See NOTION_SETUP.md for detailed instructions
# For Replit: Managed automatically via Connectors
# For Local/OAuth: Create integration at notion.com/my-integrations

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# For internal integration (alternative to OAuth):
# NOTION_TOKEN=secret_your_integration_token

# ══════════════════════════════════════════════════════════
# OPTIONAL INPUT SOURCE INTEGRATIONS
# ══════════════════════════════════════════════════════════
# Choose one or more based on your team's needs
# Each requires separate setup - see individual setup guides

# ──────────────────────────────────────────────────────────
# SLACK INTEGRATION (Optional - For Team Conversations)
# ──────────────────────────────────────────────────────────
# See SLACK_SETUP.md for detailed instructions
# Setup time: ~20 minutes
# Best for: Quick decisions, policies, team discussions

# App Token (starts with xapp-) - For Socket Mode
SLACK_APP_TOKEN=

# Bot User OAuth Token (starts with xoxb-) - For API access
SLACK_BOT_TOKEN=

# Signing Secret - For webhook verification  
SLACK_SIGNING_SECRET=

# ──────────────────────────────────────────────────────────
# GOOGLE INTEGRATIONS (Optional)
# ──────────────────────────────────────────────────────────
# See GOOGLE_DRIVE_SETUP.md for detailed instructions
# Setup time: ~30 minutes
# Used for: Google Drive, Google Meet
# Requires: Google Cloud Project with OAuth 2.0

# OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access tokens (managed automatically per team)
# GOOGLE_DRIVE_TOKEN=auto-managed-in-database
# GOOGLE_MEET_TOKEN=auto-managed-in-database

# ──────────────────────────────────────────────────────────
# ZOOM INTEGRATION (Optional - For Meeting Transcripts)
# ──────────────────────────────────────────────────────────
# See MEETING_SETUP.md for detailed instructions
# Setup time: ~30 minutes
# Best for: Extracting decisions/action items from meetings
# Requires: Zoom Pro/Business/Enterprise account

# OAuth 2.0 Credentials
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Webhook Secret (for signature verification)
ZOOM_WEBHOOK_SECRET=

# Access Token (managed automatically, refreshes every hour)
# ZOOM_ACCESS_TOKEN=auto-managed-refreshes-hourly

# Account ID (for Server-to-Server OAuth)
# ZOOM_ACCOUNT_ID=

# ══════════════════════════════════════════════════════════
# ADMIN & MONITORING (Optional)
# ══════════════════════════════════════════════════════════

# System administrators (comma-separated emails)
# Users with these emails get access to admin dashboard
ADMIN_EMAILS=

# Application base URL (for email links, webhooks)
# Auto-detected for Replit, set manually for custom deployments
BASE_URL=

# ══════════════════════════════════════════════════════════
# NOTES & GETTING STARTED
# ══════════════════════════════════════════════════════════
#
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Fill in DATABASE_URL and SESSION_SECRET
# 3. Add Anthropic API key (AI_INTEGRATIONS_ANTHROPIC_API_KEY)
# 4. Add Resend API key (RESEND_API_KEY)
# 5. Connect Notion (see NOTION_SETUP.md)
# 6. Choose input sources (Slack, Drive, Zoom, etc.)
#
# INTEGRATION PRIORITY:
# ✅ Required: Database, Session, Anthropic AI, Resend, Notion
# 🎯 Recommended: Slack (easiest to set up)
# 📄 Optional: Google Drive (for documents)
# 📹 Optional: Zoom/Meet (for meetings)
#
# DETAILED GUIDES:
# - INTEGRATIONS_MASTER_GUIDE.md - Overview of all integrations
# - NOTION_SETUP.md - Notion integration (required)
# - SLACK_SETUP.md - Slack integration
# - GOOGLE_DRIVE_SETUP.md - Google Drive integration
# - MEETING_SETUP.md - Zoom & Google Meet integrations
#
# SECURITY:
# - Never commit .env file to version control
# - Generate strong SESSION_SECRET: openssl rand -hex 32
# - Rotate API keys periodically
# - Use minimal permissions for each integration
# - Review access logs regularly
#
# TROUBLESHOOTING:
# - Check application logs for errors
# - Verify all required variables are set
# - Ensure no trailing spaces in values
# - Restart application after changes
# - See INTEGRATIONS_MASTER_GUIDE.md for common issues
#
# ══════════════════════════════════════════════════════════
