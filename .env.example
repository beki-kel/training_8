# ══════════════════════════════════════════════════════════
# Current - Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# Most values here are for local development
# ══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# Core Application
# ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# ─────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────
# For local PostgreSQL:
DATABASE_URL=postgresql://current:current_password@localhost:5432/current_db

# For Docker PostgreSQL (setup.sh will update this if using Docker):
# DATABASE_URL=postgresql://current:current_password@localhost:5556/current_db

# ─────────────────────────────────────────────────────────
# Authentication & Session
# ─────────────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Replit OAuth (only needed when deploying on Replit)
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DOMAINS=
# REPLIT_CONNECTORS_HOSTNAME=
# REPL_IDENTITY=
# WEB_REPL_RENEWAL=
# REPLIT_DEPLOYMENT=

# ─────────────────────────────────────────────────────────
# AI Integration (Anthropic Claude)
# ─────────────────────────────────────────────────────────
# Get your API key at: https://console.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ─────────────────────────────────────────────────────────
# Email Service (Resend)
# ─────────────────────────────────────────────────────────
# Get your API key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────
# Slack Integration
# ─────────────────────────────────────────────────────────
# See SLACK_SETUP.md for detailed setup instructions
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────
# Google OAuth & Services
# ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_TOKEN=
GOOGLE_DRIVE_TOKEN=

# ─────────────────────────────────────────────────────────
# Zoom Integration
# ─────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────
# Notion Integration
# ─────────────────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════
# Notes:
# - Required for basic functionality: DATABASE_URL, SESSION_SECRET
# - AI features require: AI_INTEGRATIONS_ANTHROPIC_API_KEY
# - Email invitations require: RESEND_API_KEY, RESEND_FROM_EMAIL
# - All other integrations are optional
# ══════════════════════════════════════════════════════════
